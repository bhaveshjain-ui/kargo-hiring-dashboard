# Postgres connection string (Neon: https://neon.tech — free tier is fine)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Gemini API key(s) (https://aistudio.google.com/apikey)
# Comma-separated list — if one key is dead, rate-limited, or out of quota,
# the app automatically retries the next one. A single key also works fine.
GEMINI_API_KEYS="your-gemini-api-key-1,your-gemini-api-key-2"
# Optional: override the model used for scoring/briefs/email drafts
GEMINI_MODEL="gemini-3.8-flash"

# Resend (https://resend.com)
RESEND_API_KEY="your-resend-api-key"
# Must be a verified sender on your Resend account/domain
RESEND_FROM_EMAIL="Arjun at Kargo <hiring@yourdomain.com>"

# Simple shared password gating the dashboard (this is a single-user internal tool)
DASHBOARD_PASSWORD="change-me"

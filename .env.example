# Postgres connection string (Neon: https://neon.tech — free tier is fine)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Gemini API key(s) (https://aistudio.google.com/apikey)
# Comma-separated list — if one key is dead, rate-limited, or out of quota,
# the app automatically retries the next one. A single key also works fine.
GEMINI_API_KEYS="your-gemini-api-key-1,your-gemini-api-key-2"
# Optional: override the model used for scoring/briefs/email drafts
GEMINI_MODEL="gemini-3.8-flash"

# Resend (https://resend.com)
RESEND_API_KEY="your-resend-api-key"
# Must be a verified sender on your Resend account/domain. Until you've
# verified a real domain, use Resend's sandbox default below — a custom
# domain's address here will fail every send.
RESEND_FROM_EMAIL="Arjun at Kargo <onboarding@resend.dev>"
# Optional: without a verified domain, Resend only delivers to the account
# owner's own verified email — every other `to` address is rejected. Set
# this to that verified email to redirect all sends there for testing.
# Remove it once a real domain is verified, so candidates get the real send.
RESEND_TEST_RECIPIENT_EMAIL="you@example.com"

# Simple shared password gating the dashboard (this is a single-user internal tool)
DASHBOARD_PASSWORD="change-me"
